# Copy to .env; keep secrets on the server only.
# demo: scripted fixtures; live: real intent, documents and grounded answers.
AI_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3001
HOST=127.0.0.1
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INTENT_CONFIDENCE_THRESHOLD=0.65
JOURNEY_CONFIDENCE_THRESHOLD=0.75
HUMAN_REVIEW_THRESHOLD=0.55
AI_TIMEOUT_MS=10000
# Optional: log only provider/model/latency/validation metadata, never content.
AI_DEBUG_METADATA=false

# Zero-cost guard: confirm in AI Studio that this Key belongs to an unbilled Free Tier project.
GEMINI_FREE_TIER_CONFIRMED=false
ALLOW_PAID_AI=false
LIVE_AI_REQUEST_LIMIT=12

# Production never enables the Demo API. /demo remains a frontend local adapter.
# Leave unavailable until Stage A and Free Tier verification pass.
# AI_MODE=unavailable
# NODE_ENV=production
# Set true for gated local Live staging (production always requires this boundary).
AI_SYNTHETIC_TEST_ONLY=false
# Generate a separate operator token; never use the Gemini key as this token.
NAVI_TEST_SESSION_TOKEN=
# Absolute path inside an existing 0700 private, persistent directory (not a release or /tmp).
AI_USAGE_FILE=
AI_DAILY_REQUEST_LIMIT=12
AI_MAX_CONCURRENT=1
AI_MAX_ATTEMPTS=1
