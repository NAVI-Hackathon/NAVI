{
  "name": "@navi/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js --demo",
    "dev:live": "node --env-file-if-exists=.env --watch src/server.js --live",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --import ./test/networkGuard.js --test test/*.test.js",
    "test:integration": "node eval/cli.js --local",
    "test:ai": "node eval/cli.js --local",
    "eval:ai": "node eval/cli.js --local",
    "eval:ai:local": "node eval/cli.js --local",
    "eval:ai:live": "node --env-file-if-exists=.env eval/cli.js --live",
    "ai:status": "node --env-file-if-exists=.env scripts/ai-status.js",
    "eval:hospitalization": "node --import ./test/networkGuard.js eval/hospitalization/cli.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.1.0"
  }
}
