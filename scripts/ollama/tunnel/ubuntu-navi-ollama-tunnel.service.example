[Unit]
Description=NAVI Ollama reverse tunnel
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
User=navi-ollama-link
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ExecStart=/usr/bin/ssh -F /dev/null -NT -i /etc/navi-ollama-tunnel/identity -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/etc/navi-ollama-tunnel/known_hosts -o GlobalKnownHostsFile=/dev/null -o ExitOnForwardFailure=yes -o ConnectTimeout=10 -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -R 127.0.0.1:21144:127.0.0.1:11435 navi-ollama-tunnel@REPLACE_WITH_APPROVED_VPS_HOST
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
