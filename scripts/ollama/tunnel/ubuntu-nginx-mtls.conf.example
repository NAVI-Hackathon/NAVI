# Separate loopback listener on Ubuntu. A NAVI-only client CA must issue the
# staging client certificate. Ollama itself remains on 127.0.0.1:11434.
server {
    listen 127.0.0.1:11436 ssl;
    server_name navi-inference.internal;
    ssl_certificate /etc/navi-ollama-tunnel/gateway.crt;
    ssl_certificate_key /etc/navi-ollama-tunnel/gateway.key;
    ssl_client_certificate /etc/navi-ollama-tunnel/navi-client-ca.crt;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log off;
    client_max_body_size 6m;
    proxy_connect_timeout 3s;
    proxy_read_timeout 85s;
    proxy_send_timeout 10s;
    proxy_next_upstream off;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_set_header Host 127.0.0.1:11437;
    # This root-owned include sets a fixed NAVI Broker Bearer credential.
    include /etc/navi-ollama-tunnel/navi-broker-auth.conf;
    proxy_set_header Cookie "";

    location = /api/version { limit_except GET { deny all; } proxy_pass http://127.0.0.1:11437; }
    location = /api/tags    { limit_except GET { deny all; } proxy_pass http://127.0.0.1:11437; }
    location = /api/show    { limit_except POST { deny all; } proxy_pass http://127.0.0.1:11437; }
    location = /api/chat    { limit_except POST { deny all; } proxy_pass http://127.0.0.1:11437; }
    location / { return 404; }
}
