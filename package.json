{
  "name": "navi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/mock-site"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run knowledge:check && npm run build --workspace @navi/web && node scripts/security/public-artifacts.js apps/web/dist",
    "preview": "npm run preview --workspace @navi/web",
    "test": "npm run test:web && npm run test:api",
    "dev:web": "npm run dev --workspace @navi/web",
    "dev:api": "npm run dev --workspace @navi/api",
    "test:web": "node --import ./apps/api/test/networkGuard.js --test apps/web/src/domain/*.test.js apps/web/src/hooks/motion.test.js apps/web/src/services/*.test.js",
    "test:api": "npm run test --workspace @navi/api",
    "test:integration": "npm run test:integration --workspace @navi/api",
    "dev:navi": "node scripts/dev.js",
    "dev:mock": "npm run dev --workspace @navi/mock-site",
    "dev:all": "node scripts/dev.js --all",
    "build:navi": "npm run build",
    "build:mock": "npm run knowledge:check && npm run build --workspace @navi/mock-site && node scripts/security/public-artifacts.js apps/mock-site/.next/static apps/mock-site/.next/server/app",
    "build:all": "npm run build:navi && npm run build:mock",
    "lint": "npm run lint --workspace @navi/mock-site",
    "typecheck:mock": "npm run typecheck --workspace @navi/mock-site",
    "test:sites": "node scripts/verify-sites.js",
    "test:ai": "npm run test:ai --workspace @navi/api --",
    "eval:ai": "npm run eval:ai:local",
    "eval:ai:local": "npm run eval:ai:local --workspace @navi/api --",
    "eval:ai:live": "npm run eval:ai:live --workspace @navi/api --",
    "ai:status": "npm run ai:status --workspace @navi/api",
    "dev:live": "node scripts/dev.js --live",
    "eval:hospitalization": "npm run eval:hospitalization --workspace @navi/api",
    "eval:knowledge": "npm run eval:knowledge --workspace @navi/api",
    "evidence:demo": "node scripts/evidence-pack.js",
    "test:competition:e2e": "node --import ./apps/api/test/networkGuard.js scripts/evidence/competition-e2e.js",
    "test:shared:browser": "node scripts/evidence/browser-build.js",
    "knowledge:project": "node scripts/knowledge/project-public.js",
    "knowledge:check": "node scripts/knowledge/project-public.js --check",
    "security:public": "node scripts/security/public-artifacts.js apps/web/dist apps/mock-site/.next/static apps/mock-site/.next/server/app",
    "test:layout": "playwright test -c tests/layout/playwright.config.js",
    "knowledge:init": "node scripts/knowledge/cli.js init",
    "knowledge:refresh": "node scripts/knowledge/cli.js refresh",
    "knowledge:import": "node scripts/knowledge/cli.js import",
    "knowledge:review": "node scripts/knowledge/cli.js review",
    "knowledge:publish": "node scripts/knowledge/cli.js publish",
    "knowledge:status": "node scripts/knowledge/cli.js status",
    "knowledge:diff": "node scripts/knowledge/cli.js diff",
    "knowledge:rollback": "node scripts/knowledge/cli.js rollback",
    "test:knowledge-lifecycle": "node --import ./apps/api/test/networkGuard.js --test apps/api/test/knowledgeLifecycle.test.js",
    "knowledge:demo": "node scripts/knowledge/demo.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
