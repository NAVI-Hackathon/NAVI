{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NAVI A3 request and response schemas",
  "description": "Generated from shared/product.js. Endpoint authorization, status and custom refinements remain defined by a3-persistence-contract.md and runtime Zod validation; not a deployed capability declaration.",
  "$defs": {
    "ConversationReplySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "failure": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z_]+$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        },
        "clarification": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "service_unspecified",
                "claim_type_missing",
                "date_context_missing",
                "payment_or_dividend",
                "address_type_missing",
                "beneficiary_type_missing",
                "payment_details_missing",
                "insurance_decision"
              ]
            },
            "blocking": {
              "type": "boolean"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "options": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "required": [
            "reason",
            "blocking",
            "question",
            "options"
          ],
          "additionalProperties": false
        },
        "correctionRequired": {
          "type": "boolean"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "messages": {
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 6000
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "role",
              "text",
              "at"
            ],
            "additionalProperties": false
          }
        },
        "understanding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "tasks": {
                  "minItems": 1,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "persistedTaskId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^task-[1-4]$"
                      },
                      "input": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "data": {
                        "type": "object",
                        "properties": {
                          "intent": {
                            "type": "string",
                            "enum": [
                              "service_request",
                              "knowledge_query",
                              "unknown"
                            ]
                          },
                          "serviceType": {
                            "type": "string",
                            "enum": [
                              "flight_delay",
                              "vehicle_accident",
                              "payment_method_change",
                              "policy_change",
                              "policy_information",
                              "hospitalization_claim",
                              "outpatient_claim",
                              "unknown"
                            ]
                          },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "summary": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          },
                          "extractedData": {
                            "type": "object",
                            "properties": {
                              "origin": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 120
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "destination": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 120
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "delayMinutes": {
                                "anyOf": [
                                  {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 525600
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "incidentDate": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "format": "date",
                                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "hospitalName": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 120
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "patientName": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 120
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "admissionDate": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "format": "date",
                                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "dischargeDate": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "format": "date",
                                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "reportedInpatientDays": {
                                "anyOf": [
                                  {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 3660
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              }
                            },
                            "required": [
                              "origin",
                              "destination",
                              "delayMinutes",
                              "incidentDate"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "intent",
                          "serviceType",
                          "confidence",
                          "summary",
                          "extractedData"
                        ],
                        "additionalProperties": false
                      },
                      "outcome": {
                        "type": "string",
                        "enum": [
                          "supported",
                          "preview",
                          "clarification",
                          "human_review"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "input",
                      "data",
                      "outcome"
                    ],
                    "additionalProperties": false
                  }
                },
                "batchId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "nextStep": {
                  "type": "string",
                  "const": "confirm_one_task"
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "live",
                    "demo"
                  ]
                },
                "isMock": {
                  "type": "boolean"
                },
                "disclaimer": {
                  "type": "string"
                }
              },
              "required": [
                "tasks",
                "nextStep",
                "provider",
                "isMock",
                "disclaimer"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "answer": {
          "type": "string",
          "maxLength": 6000
        },
        "evidence": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "answered",
                "not_found",
                "out_of_scope"
              ]
            },
            "results": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "section": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "prototype_guide",
                              "prototype_faq"
                            ]
                          },
                          "isMock": {
                            "type": "boolean",
                            "const": true
                          },
                          "url": {
                            "type": "null"
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "section",
                          "type",
                          "isMock",
                          "url"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "sourceId": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "section": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "const": "public_site_snapshot"
                          },
                          "isMock": {
                            "type": "boolean",
                            "const": false
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "sourceUrl": {
                            "type": "string",
                            "format": "uri"
                          },
                          "retrievedAt": {
                            "type": "string",
                            "format": "date",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                          },
                          "navigationDestination": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "page",
                                  "form",
                                  "faq",
                                  "entry_point"
                                ]
                              },
                              "path": {
                                "type": "string",
                                "pattern": "^\\/(?!\\/)[a-z0-9/_-]*$"
                              },
                              "anchor": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "label": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 40
                              },
                              "source": {
                                "type": "object",
                                "properties": {
                                  "url": {
                                    "type": "string",
                                    "pattern": "^https:\\/\\/life\\.cardif\\.com\\.tw\\/"
                                  },
                                  "title": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 80
                                  },
                                  "retrievedAt": {
                                    "type": "string",
                                    "format": "date",
                                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                                  }
                                },
                                "required": [
                                  "url",
                                  "title",
                                  "retrievedAt"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "kind",
                              "path",
                              "anchor",
                              "label",
                              "source"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "id",
                          "sourceId",
                          "title",
                          "section",
                          "type",
                          "isMock",
                          "url",
                          "sourceUrl",
                          "retrievedAt",
                          "navigationDestination"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "excerpts": {
                    "minItems": 1,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "snapshot": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": [
                          "snapshot_available",
                          "review_recommended"
                        ]
                      },
                      "ageDays": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "status",
                      "ageDays"
                    ],
                    "additionalProperties": false
                  },
                  "verificationScope": {
                    "type": "string",
                    "const": "local_snapshot"
                  },
                  "liveWebsiteChecked": {
                    "type": "boolean",
                    "const": false
                  }
                },
                "required": [
                  "source",
                  "excerpts",
                  "snapshot",
                  "verificationScope",
                  "liveWebsiteChecked"
                ],
                "additionalProperties": false
              }
            },
            "hotline": {
              "type": "string"
            },
            "disclaimer": {
              "type": "string"
            },
            "clarification": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "enum": [
                    "service_unspecified",
                    "claim_type_missing",
                    "date_context_missing",
                    "payment_or_dividend",
                    "address_type_missing",
                    "beneficiary_type_missing",
                    "payment_details_missing",
                    "insurance_decision"
                  ]
                },
                "blocking": {
                  "type": "boolean"
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "options": {
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              },
              "required": [
                "reason",
                "blocking",
                "question",
                "options"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "results",
            "hotline",
            "disclaimer"
          ],
          "additionalProperties": false
        },
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "retrieval"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeVersion": {
          "type": "string"
        }
      },
      "required": [
        "conversationId",
        "messages",
        "understanding",
        "answer",
        "evidence",
        "mode",
        "errorCode",
        "knowledgeVersion"
      ],
      "additionalProperties": false
    },
    "ConversationRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "message",
        "requestId"
      ],
      "additionalProperties": false
    },
    "CredentialsSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{3,40}$"
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        }
      },
      "required": [
        "password"
      ],
      "additionalProperties": false
    },
    "EmailRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 254,
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": [
        "email"
      ],
      "additionalProperties": false
    },
    "HandoffDraftRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "journeyVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "journeyVersion",
        "text",
        "version"
      ],
      "additionalProperties": false
    },
    "HandoffDraftResponseSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "draft": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "journeyId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "text": {
                  "type": "string",
                  "maxLength": 2000
                },
                "version": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "journeyVersion": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "delivery": {
                  "type": "string",
                  "const": "not_sent"
                },
                "stale": {
                  "type": "boolean"
                }
              },
              "required": [
                "journeyId",
                "text",
                "version",
                "journeyVersion",
                "updatedAt",
                "delivery",
                "stale"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "draft"
      ],
      "additionalProperties": false
    },
    "ResetPasswordRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        }
      },
      "required": [
        "token",
        "password"
      ],
      "additionalProperties": false
    },
    "SavedMessageSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 6000
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "role",
        "text",
        "at"
      ],
      "additionalProperties": false
    },
    "TaskJourneyRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "idempotencyKey": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "taskId",
        "idempotencyKey"
      ],
      "additionalProperties": false
    },
    "VerifyEmailRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "token"
      ],
      "additionalProperties": false
    },
    "WorkflowProgressSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "checked": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "checked",
        "revision"
      ],
      "additionalProperties": false
    }
  }
}
